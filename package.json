{
  "name": "little-dev-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build": "tailwindcss -i ./src/styles.css -o ./assets/styles.css --minify",
    "watch": "tailwindcss -i ./src/styles.css -o ./assets/styles.css --watch",
    "dev": "python3 -m http.server 5173 --bind 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.0"
  }
}
